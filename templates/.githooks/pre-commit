#!/usr/bin/env bash
set -euo pipefail

git_dir="$(git rev-parse --git-dir)"
expected_branch_file="$git_dir/agent-expected-branch"
expected_worktree_file="$git_dir/agent-expected-worktree"

if [ ! -f "$expected_branch_file" ]; then
  echo "Warning: guardrail check skipped because '$expected_branch_file' does not exist." >&2
  exit 0
fi

expected_branch=""
if ! expected_branch="$(cat "$expected_branch_file")"; then
  echo "Blocked: unable to read expected branch metadata from '$expected_branch_file'." >&2
  exit 1
fi

expected_worktree=""
if [ ! -f "$expected_worktree_file" ]; then
  echo "Blocked: expected worktree metadata file '$expected_worktree_file' is missing." >&2
  exit 1
fi
if ! expected_worktree="$(cat "$expected_worktree_file")"; then
  echo "Blocked: unable to read expected worktree metadata from '$expected_worktree_file'." >&2
  exit 1
fi

current_branch="$(git symbolic-ref --short -q HEAD || true)"
current_worktree="$(git rev-parse --show-toplevel)"

if [ "$current_branch" != "$expected_branch" ]; then
  echo "Blocked: this worktree is bound to '$expected_branch', current is '$current_branch'." >&2
  exit 1
fi

if [ "$current_worktree" != "$expected_worktree" ]; then
  echo "Blocked: commits are allowed only from '$expected_worktree'." >&2
  exit 1
fi
